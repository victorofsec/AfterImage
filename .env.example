# Generate with: openssl rand -hex 32
IP_HASH_SECRET=replace-with-a-stable-random-secret

# Protects the /stats endpoint. Generate with: openssl rand -hex 32
ADMIN_TOKEN=replace-with-a-separate-random-token

# Set only when the app is behind exactly this many trusted reverse proxies.
TRUSTED_PROXY_COUNT=0

# Optional storage locations. Relative paths are resolved from the working directory.
DATABASE_PATH=data.db
UPLOAD_FOLDER=uploads

# Keep disabled outside local development.
FLASK_DEBUG=0
